  product     Product        @relation(fields: [productId], references: [id])
  productId   String
  lot         InventoryLot?  @relation(fields: [lotId], references: [id])
  lotId       String?
  location    StockLocation? @relation(fields: [locationId], references: [id])
  locationId  String?
  quantity    Int
  type        String
  status      String         @default("pending")
  reason      String
  requestedBy String
  approvedBy  String?
  referenceId String?
  createdAt   DateTime       @default(now())
  decidedAt   DateTime?
  metadata    Json           @default("{}")

  @@index([productId])
  @@index([lotId])
  @@index([locationId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model InventoryPeriodClose {
  id               String                    @id
  closeNumber      String                    @unique
  periodType       String
  periodKey        String                    @unique
  status           String                    @default("draft")
  effectiveAt      DateTime
  openedAt         DateTime?
  countSessionId   String?
  totalQuantity    Int                       @default(0)
  totalValue       Float                     @default(0)
  varianceQuantity Int                       @default(0)
  varianceValue    Float                     @default(0)
  createdBy        String
  reviewedBy       String?
  closedBy         String?
  reviewedAt       DateTime?
  closedAt         DateTime?
  notes            String                    @default("")
  metadata         Json                      @default("{}")
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime
  snapshots        InventoryPeriodSnapshot[]

  @@index([periodType])
  @@index([status])
  @@index([effectiveAt(sort: Desc)])
}

model InventoryPeriodSnapshot {
  id                     String               @id
  inventoryPeriodClose   InventoryPeriodClose @relation(fields: [inventoryPeriodCloseId], references: [id], onDelete: Cascade)
  inventoryPeriodCloseId String
  product                Product              @relation(fields: [productId], references: [id])
  productId              String
  lot                    InventoryLot?        @relation(fields: [lotId], references: [id])
  lotId                  String?
  location               StockLocation        @relation(fields: [locationId], references: [id])
  locationId             String
  onHand                 Int
  reserved               Int
  damaged                Int
  hold                   Int
  available              Int
  unitCost               Float                @default(0)
  stockValue             Float                @default(0)
  metadata               Json                 @default("{}")
  createdAt              DateTime             @default(now())

  @@unique([inventoryPeriodCloseId, productId, lotId, locationId])
  @@index([productId])
  @@index([lotId])
  @@index([locationId])
}

model ProductVendor {
  id           String   @id
  productId    String
  vendorId     String
  vendorSku    String?
  vendorName   String
  leadTimeDays Int      @default(0)
  minOrderQty  Int      @default(1)
  packMultiple Int      @default(1)
  lastCost     Float    @default(0)
  preferred    Boolean  @default(false)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  metadata     Json     @default("{}")

  @@unique([productId, vendorId])
  @@index([productId])
  @@index([vendorId])
  @@index([preferred])
  @@index([status])
}

model ReorderPolicy {
  id                String   @id
  productId         String   @unique
  preferredVendorId String?
  minQuantity       Int      @default(0)
  maxQuantity       Int      @default(0)
  reorderPoint      Int      @default(0)
  reorderQuantity   Int      @default(0)
  leadTimeDays      Int      @default(0)
  packMultiple      Int      @default(1)
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  metadata          Json     @default("{}")

  @@index([preferredVendorId])
  @@index([status])
}

model DispatchPackage {
  id            String    @id
  dispatchJobId String
  challanId     String
  packageNumber String
  boxCount      Int       @default(1)
  status        String    @default("packed")
  packedBy      String?
  packedAt      DateTime?
  remarks       String    @default("")
  photos        Json      @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  metadata      Json      @default("{}")

  @@unique([challanId, packageNumber])
  @@index([dispatchJobId])
  @@index([challanId])
  @@index([status])
}

model DispatchLine {
  id                 String         @id
  dispatchJobId      String
  challanId          String?
  salesOrderId       String?
  salesOrderLineId   String?
  dispatchKey        String
  productId          String?
  pickLine           PickLine?      @relation(fields: [pickLineId], references: [id])
  pickLineId         String?
  lot                InventoryLot?  @relation(fields: [lotId], references: [id])
  lotId              String?
  location           StockLocation? @relation(fields: [locationId], references: [id])
  locationId         String?
  sku                String
  name               String
  orderedQuantity    Int
  packedQuantity     Int            @default(0)
  dispatchedQuantity Int            @default(0)
  deliveredQuantity  Int            @default(0)
  returnedQuantity   Int            @default(0)
  status             String         @default("packed")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime
  metadata           Json           @default("{}")
  returnLines        ReturnLine[]

  @@index([dispatchJobId])
  @@index([challanId])
  @@index([salesOrderId])
  @@index([salesOrderLineId])
  @@index([productId])
  @@index([pickLineId])
  @@index([lotId])
  @@index([locationId])
  @@index([status])
}

model Shipment {
  id              String    @id
  shipmentNumber  String    @unique
  dispatchJobId   String
  challanId       String
  transporterName String?
  vehicleNumber   String?
  driverName      String?
  contactPhone    String?
  status          String    @default("ready")
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  metadata        Json      @default("{}")

  @@index([dispatchJobId])
  @@index([challanId])
  @@index([status])
}

model DeliveryProof {
  id              String   @id
  shipmentId      String?
  challanId       String   @unique
  receivedByName  String
  receivedByPhone String?
  proofType       String   @default("manual")
  proofUrl        String?
  latitude        Float?
  longitude       Float?
  capturedAt      DateTime @default(now())
  createdBy       String
  metadata        Json     @default("{}")

  @@index([shipmentId])
  @@index([challanId])
  @@index([capturedAt(sort: Desc)])
}

model ReturnOrder {
  id             String    @id
  returnNumber   String    @unique
  idempotencyKey String?   @unique
  salesOrderId   String?
  challanId      String?
  customerId     String?
  status         String    @default("draft")
  reason         String
  refundMode     String?
  refundAmount   Float     @default(0)
  createdBy      String
  approvedBy     String?
  receivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  metadata       Json      @default("{}")

  @@index([salesOrderId])
  @@index([challanId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model CreditNote {
  id               String   @id
  creditNoteNumber String   @unique
  returnOrderId    String   @unique
  salesOrderId     String?
  customerId       String?
  amount           Float
  unappliedAmount  Float    @default(0)
  refundMode       String
  status           String   @default("issued")
  issuedAt         DateTime @default(now())
  createdBy        String
  notes            String   @default("")
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime

  @@index([salesOrderId])
  @@index([customerId])
  @@index([status])
  @@index([issuedAt(sort: Desc)])
}

model ReturnLine {
  id                     String          @id
  returnOrderId          String
  dispatchLine           DispatchLine?   @relation(fields: [dispatchLineId], references: [id])
  dispatchLineId         String?
  salesOrderLine         SalesOrderLine? @relation(fields: [salesOrderLineId], references: [id])
  salesOrderLineId       String?
  product                Product?        @relation(fields: [productId], references: [id])
  productId              String?
  lot                    InventoryLot?   @relation(fields: [lotId], references: [id])
  lotId                  String?
  locationId             String?
  sku                    String
  name                   String
  quantity               Int
  acceptedQuantity       Int             @default(0)
  resellQuantity         Int             @default(0)
  damagedQuantity        Int             @default(0)
  supplierReturnQuantity Int             @default(0)
  disposition            String          @default("inspect")
  status                 String          @default("pending")
  createdAt              DateTime        @default(now())
  updatedAt              DateTime
  metadata               Json            @default("{}")

  @@index([returnOrderId])
  @@index([dispatchLineId])
  @@index([salesOrderLineId])
  @@index([productId])
  @@index([lotId])
  @@index([locationId])
  @@index([status])
}

model User {
  id                  String         @id
  name                String
  email               String         @unique
  passwordHash        String
  role                String
  phone               String
  active              Boolean        @default(true)
  /// Optional uploaded avatar URL. When null the UI falls back to a
  /// deterministic colour + initials block derived from `id`.
  avatarUrl           String?
  /// One-line bio shown on the profile page. Not validated; kept short
  /// (<= 280 chars) in the resolver.
  bio                 String?
  /// Per-user RBAC changes layered on top of the base role. Keys map to
  /// explicit permissions such as users.manage or products.manage.
  permissionOverrides Json           @default("{}")
  /// Audit trail for password rotations. Used by the profile page to show
  /// "last changed N days ago" + by future password-expiry policies.
  passwordChangedAt   DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  leads               Lead[]
  quotes              Quote[]
  activities          Activity[]
  followUps           FollowUpTask[]
  dispatchJobs        DispatchJob[]
  salesOrders         SalesOrder[]
}

model Vendor {
  id            String   @id
  name          String
  phone         String?
  email         String?
  gstNo         String?
  address       String?
  city          String?
  state         String?
  contactPerson String?
  category      String?
  status        String   @default("active")
  notes         String?
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime

  @@index([name])
  @@index([status])
}
