generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id        String   @id
  lead      Lead?    @relation(fields: [leadId], references: [id])
  leadId    String?
  quote     Quote?   @relation(fields: [quoteId], references: [id])
  quoteId   String?
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      String
  message   String
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([quoteId])
  @@index([userId])
  @@index([type])
  @@index([createdAt(sort: Desc)])
}

model AppSetting {
  id                        String   @id
  canonicalAppUrl           String
  quotePrefix               String
  challanPrefix             String
  approvalDiscountThreshold Float
  companyName               String
  logoUrl                   String   @default("/brand/marble-park-logo.png")
  companyAddress            String   @default("")
  gstNumber                 String   @default("")
  website                   String   @default("")
  quotationTitle            String   @default("PROFORMA / QUOTATION")
  documentTagline           String   @default("Premium bath, tile and surface selections for considered spaces.")
  defaultTerms              String   @default("")
  bankDetails               String   @default("")
  documentFooter            String   @default("")
  quoteBrandSelectionMode   String   @default("all")
  quoteBrandIds             Json     @default("[]")
  supportPhone              String
  supportEmail              String
  updatedAt                 DateTime
}

model AuditEvent {
  id          String   @id
  actorUserId String
  action      String
  entityType  String
  entityId    String
  summary     String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId], map: "AuditEvent_entity_idx")
  @@index([action, createdAt(sort: Desc)], map: "AuditEvent_action_created_idx")
}

model Customer {
  id               String            @id
  name             String
  mobile           String
  email            String?
  gstNo            String?
  architectName    String?
  designerName     String?
  siteAddress      String
  city             String
  state            String?
  notes            String?
  tags             Json              @default("[]")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  leads            Lead[]
  quotes           Quote[]
  dispatchJobs     DispatchJob[]
  dispatchChallans DispatchChallan[]
  salesOrders      SalesOrder[]

  @@index([name])
  @@index([mobile])
  @@index([email])
  @@index([gstNo])
}

/// Consulting architect / firm master — selected per quote for PDF, filters and reports.
model Architect {
  id             String   @id
  name           String
  phone          String?
  email          String?
  firmName       String?
  city           String?
  address        String?
  registrationNo String?
  status         String   @default("active")
  notes          String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  quotes         Quote[]

  @@index([name])
  @@index([status])
  @@index([firmName])
  @@index([city])
}

model DispatchChallan {
  id              String      @id
  challanNumber   String      @unique
  quote           Quote?      @relation(fields: [quoteId], references: [id])
  quoteId         String?
  salesOrder      SalesOrder? @relation("SalesOrderChallans", fields: [salesOrderId], references: [id])
  salesOrderId    String?
  dispatchJob     DispatchJob @relation(fields: [dispatchJobId], references: [id])
  dispatchJobId   String
  customer        Customer    @relation(fields: [customerId], references: [id])
  customerId      String
  status          String
  createdAt       DateTime    @default(now())
  packedAt        DateTime?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  vehicleNumber   String?
  driverName      String?
  transporterName String?
  contactPhone    String
  siteAddress     String
  remarks         String
  lines           Json
  proof           Json?
  updatedAt       DateTime

  @@index([quoteId])
  @@index([salesOrderId])
  @@index([dispatchJobId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model DispatchJob {
  id               String            @id
  quote            Quote?            @relation(fields: [quoteId], references: [id])
  quoteId          String?
  salesOrder       SalesOrder?       @relation("SalesOrderDispatchJob", fields: [salesOrderId], references: [id])
  salesOrderId     String?           @unique
  customer         Customer          @relation(fields: [customerId], references: [id])
  customerId       String
  siteAddress      String
  status           String
  dueDate          DateTime
  owner            User              @relation(fields: [ownerId], references: [id])
  ownerId          String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  dispatchChallans DispatchChallan[]

  @@index([quoteId])
  @@index([customerId])
  @@index([ownerId])
  @@index([status])
  @@index([dueDate])
}

model FollowUpTask {
  id        String   @id
  lead      Lead     @relation(fields: [leadId], references: [id])
  leadId    String
  owner     User     @relation(fields: [ownerId], references: [id])
  ownerId   String
  dueAt     DateTime
  status    String
  notes     String
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([leadId])
  @@index([ownerId])
  @@index([status])
  @@index([dueAt])
}

model InventoryBalance {
  id                     String   @id
  product                Product  @relation(fields: [productId], references: [id])
  productId              String   @unique
  onHand                 Int
  reserved               Int
  available              Int
  damaged                Int
  hold                   Int
  /// Warning level — when available drops at or below this (>0) emit stock_warning
  /// (unless already critical). 0 disables the warning tier. Default = 5.
  lowStockThreshold      Int      @default(5)
  /// Critical breach level. When available <= this (>0), emit stock_critical.
  criticalStockThreshold Int?
  /// Optional explicit reorder point for purchase planning (procurement).
  /// Kept separate from alert tiers; not the primary UI alert threshold.
  reorderPoint           Int?
  updatedAt              DateTime

  @@index([available, updatedAt(sort: Desc)])
  @@index([reserved, updatedAt(sort: Desc)])
}

model InventoryInwardBatch {
  id              String   @id
  referenceNumber String   @unique
  supplierName    String
  remarks         String
  createdAt       DateTime @default(now())
  createdBy       String
  attachmentNames Json
  lines           Json
}

model InventoryMovement {
  id               String   @id
  productId        String
  type             String
  quantity         Int
  reason           String
  relatedQuoteId   String?
  relatedChallanId String?
  createdAt        DateTime @default(now())
  createdBy        String

  @@index([productId])
  @@index([type])
  @@index([relatedQuoteId])
  @@index([relatedChallanId])
  @@index([createdAt(sort: Desc)])
}

model PurchaseDemand {
  id                  String    @id
  sourceType          String    @default("sales_order")
  sourceLineKey       String    @unique
  sourceOrderId       String?
  sourceQuoteId       String?
  sourceReservationId String?
  customerId          String?
  ownerId             String?
  productId           String?
  sku                 String
  name                String
  category            String
  brand               String
  finish              String?
  unit                String    @default("PC")
  quantity            Int
  orderedQuantity     Int       @default(0)
  receivedQuantity    Int       @default(0)
  status              String    @default("open")
  priority            Int       @default(0)
  preferredVendorId   String?
  vendorName          String?
  expectedDate        DateTime?
  notes               String    @default("")
  metadata            Json      @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime

  @@index([sourceOrderId])
  @@index([sourceQuoteId])
  @@index([sourceReservationId])
  @@index([productId])
  @@index([status])
  @@index([expectedDate])
  @@index([createdAt(sort: Desc)])
}

model PurchaseOrder {
  id              String    @id
  poNumber        String    @unique
  vendorId        String?
  vendorName      String
  status          String    @default("draft")
  expectedDate    DateTime?
  sentAt          DateTime?
  orderedAt       DateTime?
  closedAt        DateTime?
  createdBy       String
  notes           String    @default("")
  /// Optional header discount % applied to qty × unitCost before GST. 0 = none.
  discountPercent Float     @default(0)
  /// Optional GST %. Null/0 = no GST on this PO.
  taxRate         Float?
  subtotal        Float     @default(0)
  discountAmount  Float     @default(0)
  taxableValue    Float     @default(0)
  taxAmount       Float     @default(0)
  grandTotal      Float     @default(0)
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime

  @@index([vendorId])
  @@index([vendorName])
  @@index([status])
  @@index([expectedDate])
  @@index([createdAt(sort: Desc)])
}

model PurchaseOrderLine {
  id                String   @id
  purchaseOrderId   String
  purchaseDemandId  String?
  productId         String?
  sku               String
  name              String
  category          String
  brand             String
  finish            String?
  unit              String   @default("PC")
  orderedQuantity   Int
  receivedQuantity  Int      @default(0)
  cancelledQuantity Int      @default(0)
  unitCost          Float    @default(0)
  discountPercent   Float    @default(0)
  taxRate           Float    @default(0)
  taxableValue      Float    @default(0)
  taxAmount         Float    @default(0)
  lineTotal         Float    @default(0)
  status            String   @default("ordered")
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime

  @@index([purchaseOrderId])
  @@index([purchaseDemandId])
  @@index([productId])
  @@index([status])
}

model GoodsReceiptNote {
  id              String   @id
  grnNumber       String   @unique
  idempotencyKey  String?  @unique
  purchaseOrderId String?
  vendorId        String?
  vendorName      String
  supplierChallan String?
  supplierBill    String?
  receivedDate    DateTime
  receivedBy      String
  status          String   @default("posted")
  notes           String   @default("")
  attachments     Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@index([purchaseOrderId])
  @@index([vendorName])
  @@index([receivedDate])
  @@index([createdAt(sort: Desc)])
}

model GoodsReceiptLine {
  id                  String        @id
  goodsReceiptNoteId  String
  purchaseOrderLineId String?
  productId           String?
  lot                 InventoryLot? @relation(fields: [lotId], references: [id])
  lotId               String?
  sku                 String
  name                String
  orderedQuantity     Int
  receivedQuantity    Int
  acceptedQuantity    Int
  damagedQuantity     Int           @default(0)
  location            String?
  unitCost            Float         @default(0)
  metadata            Json          @default("{}")
  createdAt           DateTime      @default(now())

  @@index([goodsReceiptNoteId])
  @@index([purchaseOrderLineId])
  @@index([productId])
  @@index([lotId])
}

model Lead {
  id            String         @id
  customer      Customer       @relation(fields: [customerId], references: [id])
  customerId    String
  title         String
  source        String
  owner         User           @relation(fields: [ownerId], references: [id])
  ownerId       String
  stage         String
  expectedValue Float
  createdAt     DateTime       @default(now())
  lastContactAt DateTime
  nextActionAt  DateTime
  notes         String
  reopenedAt    DateTime?
  updatedAt     DateTime
  activities    Activity[]
  quotes        Quote[]
  followUps     FollowUpTask[]

  @@index([customerId])
  @@index([ownerId])
  @@index([stage])
  @@index([nextActionAt])
  @@index([createdAt(sort: Desc)])
}

model LeadIntent {
  id                String    @id
  leadId            String
  customerId        String
  ownerId           String
  createdBy         String
  status            String
  intentType        String
  source            String
  notes             String
  followUpReason    String?
  rows              Json
  quoteId           String?
  referencesQuoteId String?
  lockedBy          String?
  lockedAt          DateTime?
  submittedAt       DateTime?
  salesOrderId      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime

  @@index([leadId])
  @@index([ownerId])
  @@index([status])
  @@index([referencesQuoteId])
  @@index([lockedBy])
  @@index([createdAt(sort: Desc)])
}

model Notification {
  id           String    @id
  title        String
  message      String
  type         String
  entityType   String?
  entityId     String?
  href         String?
  targetUserId String?
  targetRole   String?
  metadata     Json      @default("{}")
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([targetUserId])
  @@index([targetRole])
  @@index([readAt])
  @@index([createdAt(sort: Desc)])
}

model PasswordResetToken {
  id        String    @id
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ProductCategory {
  id          String    @id
  name        String    @unique
  code        String?
  description String?
  status      String    @default("active")
  sortOrder   Int       @default(0)
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  products    Product[] @relation("ProductCategoryMaster")
}

model ProductBrand {
  id          String    @id
  name        String    @unique
  code        String?
  description String?
  status      String    @default("active")
  sortOrder   Int       @default(0)
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  products    Product[] @relation("ProductBrandMaster")
}

model ProductFinish {
  id          String    @id
  name        String    @unique
  code        String?
  description String?
  status      String    @default("active")
  sortOrder   Int       @default(0)
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  products    Product[] @relation("ProductFinishMaster")
}

model ProductMaterial {
  id          String    @id
  name        String    @unique
  code        String?   @unique
  description String?
  status      String    @default("active")
  sortOrder   Int       @default(0)
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  products    Product[] @relation("ProductMaterialMaster")

  @@index([status])
  @@index([sortOrder])
}

model UnitOfMeasure {
  id           String   @id
  code         String   @unique
  name         String
  dimension    String   @default("count")
  decimalScale Int      @default(0)
  status       String   @default("active")
  sortOrder    Int      @default(0)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([dimension])
  @@index([status])
}

model TaxCode {
  id        String   @id
  code      String   @unique
  name      String
  hsnCode   String?
  rate      Float    @default(18)
  status    String   @default("active")
  sortOrder Int      @default(0)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([hsnCode])
  @@index([status])
}

model TileSize {
  id          String    @id
  name        String    @unique
  code        String?
  uom         String    @default("BOX")
  pcsPerBox   Int       @default(0)
  description String?
  status      String    @default("active")
  sortOrder   Int       @default(0)
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  products    Product[] @relation("ProductTileSizeMaster")
}

model Product {
  id                  String                    @id
  sku                 String                    @unique
  name                String
  category            String
  brand               String
  finish              String
  dimensions          String
  unit                String
  tags                Json
  sellPrice           Float
  floorPrice          Float
  costPrice           Float                     @default(0)
  mrp                 Float?
  mrpRateBasis        String?
  mrpVerifiedAt       DateTime?
  mrpVerifiedById     String?
  mrpSource           String?
  taxClass            String
  status              String
  media               Json
  sourceRefs          Json
  description         String
  internalCode        String?                   @unique
  categoryId          String?
  brandId             String?
  finishId            String?
  materialId          String?
  tileSizeId          String?
  baseUom             String                    @default("PC")
  purchaseUom         String                    @default("PC")
  salesUom            String                    @default("PC")
  piecesPerPack       Int                       @default(1)
  coveragePerPack     Float                     @default(0)
  hsnCode             String?
  trackLots           Boolean                   @default(true)
  allowLoose          Boolean                   @default(false)
  categoryMaster      ProductCategory?          @relation("ProductCategoryMaster", fields: [categoryId], references: [id])
  brandMaster         ProductBrand?             @relation("ProductBrandMaster", fields: [brandId], references: [id])
  finishMaster        ProductFinish?            @relation("ProductFinishMaster", fields: [finishId], references: [id])
  materialMaster      ProductMaterial?          @relation("ProductMaterialMaster", fields: [materialId], references: [id])
  tileSizeMaster      TileSize?                 @relation("ProductTileSizeMaster", fields: [tileSizeId], references: [id])
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime
  balances            InventoryBalance?
  reservations        Reservation[]
  aliases             ProductAlias[]
  displaySamples      DisplaySample[]
  inventoryLots       InventoryLot[]
  lotLedgerEntries    InventoryLotLedgerEntry[]
  openingStockLines   OpeningStockLine[]
  transferLines       StockTransferLine[]
  pickLines           PickLine[]
  labelInstances      InternalLabelInstance[]
  stockCountLines     StockCountLine[]
  adjustmentApprovals StockAdjustmentApproval[]
  returnLines         ReturnLine[]
  periodSnapshots     InventoryPeriodSnapshot[]

  @@index([brand])
  @@index([category])
  @@index([finish])
  @@index([status])
  @@index([name])
  @@index([categoryId])
  @@index([brandId])
  @@index([finishId])
  @@index([materialId])
  @@index([tileSizeId])
  @@index([mrp])
  @@index([mrpRateBasis])
}

model ProductAlias {
  id              String   @id
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       String
  type            String
  value           String
  normalizedValue String
  status          String   @default("active")
  isPrimary       Boolean  @default(false)
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@unique([type, normalizedValue])
  @@index([productId, status])
  @@index([normalizedValue])
}

model DisplaySample {
  id              String                  @id
  sampleNumber    String                  @unique
  product         Product                 @relation(fields: [productId], references: [id])
  productId       String
  internalCode    String                  @unique
  locationId      String?
  displayZone     String?
  displayPosition String?
  imageUrl        String?
  status          String                  @default("active")
  sellable        Boolean                 @default(false)
  installedAt     DateTime?
  removedAt       DateTime?
  metadata        Json                    @default("{}")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime
  labelInstances  InternalLabelInstance[]

  @@index([productId])
  @@index([locationId])
  @@index([status])
}

model Quote {
  id                  String            @id
  quoteNumber         String            @unique
  lead                Lead              @relation(fields: [leadId], references: [id])
  leadId              String
  customer            Customer          @relation(fields: [customerId], references: [id])
  customerId          String
  owner               User              @relation(fields: [ownerId], references: [id])
  ownerId             String
  /// Consulting architect on this quote (optional; one customer can use many architects).
  architect           Architect?        @relation(fields: [architectId], references: [id])
  architectId         String?
  /// Denormalized snapshot for PDF / history if the master row is later renamed.
  architectName       String?
  title               String
  status              String
  approvalStatus      String
  discountPercent     Float
  displayMode         String            @default("priced")
  projectName         String
  createdAt           DateTime          @default(now())
  validUntil          DateTime
  sentAt              DateTime?
  confirmedAt         DateTime?
  coverImage          String
  notes               String
  lines               Json
  versions            Json
  quoteMeta           Json              @default("{}")
  approval            Json?
  intentId            String?
  supersedesQuoteId   String?
  supersededByQuoteId String?
  versionNumber       Int               @default(1)
  updatedAt           DateTime
  activities          Activity[]
  reservations        Reservation[]
  dispatchJobs        DispatchJob[]
  dispatchChallan     DispatchChallan[]
  shares              QuoteShare[]

  @@index([leadId])
  @@index([customerId])
  @@index([ownerId])
  @@index([architectId])
  @@index([architectName])
  @@index([status])
  @@index([approvalStatus])
  @@index([validUntil])
  @@index([intentId])
  @@index([supersedesQuoteId])
  @@index([supersededByQuoteId])
  @@index([createdAt(sort: Desc)])
}

model QuoteShare {
  id            String    @id
  token         String    @unique
  quote         Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId       String
  createdBy     String
  allowDownload Boolean   @default(true)
  expiresAt     DateTime
  revokedAt     DateTime?
  viewCount     Int       @default(0)
  lastViewedAt  DateTime?
  createdAt     DateTime  @default(now())

  @@index([quoteId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Reservation {
  id               String           @id
  quote            Quote?           @relation(fields: [quoteId], references: [id])
  quoteId          String?
  salesOrderId     String?
  salesOrderLineId String?
  product          Product          @relation(fields: [productId], references: [id])
  productId        String
  locationId       String?
  quantity         Int
  status           String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  lotAllocations   LotReservation[]

  @@index([quoteId, status])
  @@index([salesOrderId, status])
  @@index([salesOrderLineId])
  @@index([productId, status])
  @@index([locationId, status])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model SalesOrder {
  id             String           @id
  orderNumber    String           @unique
  quoteId        String?
  idempotencyKey String?          @unique
  leadId         String
  customerId     String
  ownerId        String
  status         String
  paymentMode    String
  paymentStatus  String
  paymentTerms   String           @default("")
  promisedDate   DateTime?
  advanceAmount  Float
  totalAmount    Float
  lines          Json
  notes          String
  documents      Json             @default("{}")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  customer       Customer         @relation(fields: [customerId], references: [id])
  owner          User             @relation(fields: [ownerId], references: [id])
  lineItems      SalesOrderLine[]

  dispatchJob      DispatchJob?      @relation("SalesOrderDispatchJob")
  dispatchChallans DispatchChallan[] @relation("SalesOrderChallans")
  pickLists        PickList[]

  @@index([quoteId])
  @@index([leadId])
  @@index([customerId])
  @@index([ownerId])
  @@index([paymentMode])
  @@index([promisedDate, status])
  @@index([createdAt(sort: Desc)])
}

model QuoteLine {
  id                String    @id
  quoteId           String
  lineKey           String
  lineNo            Int
  productId         String?
  sku               String
  name              String
  category          String
  brand             String
  finish            String?
  area              String?
  unit              String    @default("PC")
  quantity          Int
  orderedQuantity   Int       @default(0)
  cancelledQuantity Int       @default(0)
  closedQuantity    Int       @default(0)
  listPrice         Float     @default(0)
  mrp               Float?
  mrpRateBasis      String?
  mrpSource         String?   @default("quote_entry")
  mrpConfirmedAt    DateTime?
  mrpConfirmedById  String?
  unitPrice         Float     @default(0)
  discountPercent   Float     @default(0)
  taxRate           Float     @default(18)
  taxableValue      Float     @default(0)
  taxAmount         Float     @default(0)
  grossLineTotal    Float     @default(0)
  lineTotal         Float     @default(0)
  status            String    @default("quoted")
  isTileSpecial     Boolean   @default(false)
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime

  @@unique([quoteId, lineKey])
  @@index([quoteId])
  @@index([productId])
  @@index([status])
  @@index([status, createdAt(sort: Desc), id])
  @@index([mrp])
  @@index([mrpConfirmedById])
  @@index([createdAt(sort: Desc)])
}

model SalesOrderLine {
  id                  String           @id
  salesOrderId        String
  quoteId             String?
  quoteLineId         String?
  lineKey             String
  lineNo              Int
  productId           String?
  sku                 String
  name                String
  category            String
  brand               String
  finish              String?
  area                String?
  unit                String           @default("PC")
  orderedQuantity     Int
  reservedQuantity    Int              @default(0)
