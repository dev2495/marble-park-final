generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id        String   @id
  lead      Lead?    @relation(fields: [leadId], references: [id])
  leadId    String?
  quote     Quote?   @relation(fields: [quoteId], references: [id])
  quoteId   String?
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      String
  message   String
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([quoteId])
  @@index([userId])
  @@index([type])
  @@index([createdAt(sort: Desc)])
}

model AppSetting {
  id                        String   @id
  canonicalAppUrl           String
  quotePrefix               String
  challanPrefix             String
  approvalDiscountThreshold Float
  companyName               String
  supportPhone              String
  supportEmail              String
  updatedAt                 DateTime
}

model AuditEvent {
  id          String   @id
  actorUserId String
  action      String
  entityType  String
  entityId    String
  summary     String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId], map: "AuditEvent_entity_idx")
}

model CatalogReviewTask {
  id              String   @id
  sourceFileId    String
  pageNumber      Int?
  detectedSku     String?
  detectedName    String?
  extractedText   String?
  imagePath       String?
  imageUrl        String?
  mappedProductId String?
  confidence      Float?
  raw             Json?
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime
}

model Customer {
  id               String            @id
  name             String
  mobile           String
  email            String?
  gstNo            String?
  architectName    String?
  designerName     String?
  siteAddress      String
  city             String
  state            String?
  notes            String?
  tags             Json              @default("[]")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  leads            Lead[]
  quotes           Quote[]
  dispatchJobs     DispatchJob[]
  dispatchChallans DispatchChallan[]

  @@index([name])
  @@index([mobile])
  @@index([email])
  @@index([gstNo])
}

model DispatchChallan {
  id              String      @id
  challanNumber   String      @unique
  quote           Quote       @relation(fields: [quoteId], references: [id])
  quoteId         String
  dispatchJob     DispatchJob @relation(fields: [dispatchJobId], references: [id])
  dispatchJobId   String
  customer        Customer    @relation(fields: [customerId], references: [id])
  customerId      String
  status          String
  createdAt       DateTime    @default(now())
  packedAt        DateTime?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  vehicleNumber   String?
  driverName      String?
  transporterName String?
  contactPhone    String
  siteAddress     String
  remarks         String
  lines           Json
  proof           Json?
  updatedAt       DateTime

  @@index([quoteId])
  @@index([dispatchJobId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model DispatchJob {
  id               String            @id
  quote            Quote             @relation(fields: [quoteId], references: [id])
  quoteId          String            @unique
  customer         Customer          @relation(fields: [customerId], references: [id])
  customerId       String
  siteAddress      String
  status           String
  dueDate          DateTime
  owner            User              @relation(fields: [ownerId], references: [id])
  ownerId          String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  dispatchChallans DispatchChallan[]

  @@index([customerId])
  @@index([ownerId])
  @@index([status])
  @@index([dueDate])
}

model FollowUpTask {
  id        String   @id
  lead      Lead     @relation(fields: [leadId], references: [id])
  leadId    String
  owner     User     @relation(fields: [ownerId], references: [id])
  ownerId   String
  dueAt     DateTime
  status    String
  notes     String
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([leadId])
  @@index([ownerId])
  @@index([status])
  @@index([dueAt])
}

model ImportBatch {
  id           String   @id
  sourceFileId String
  brand        String
  rowCount     Int
  status       String
  summary      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model ImportRow {
  id              String   @id
  sourceFileId    String
  importBatchId   String
  brand           String
  range           String?
  categoryCode    String?
  sku             String?
  description     String
  newMrp          Float
  raw             Json
  normalized      Json?
  mappedProductId String?
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime
}

model InventoryBalance {
  id                String   @id
  product           Product  @relation(fields: [productId], references: [id])
  productId         String   @unique
  onHand            Int
  reserved          Int
  available         Int
  damaged           Int
  hold              Int
  /// When `available` drops at or below this number the product is flagged as
  /// "low stock" on dashboards. 0 disables the alert. Default = 5 covers
  /// "almost empty" for retail showrooms; sales managers override per SKU.
  lowStockThreshold Int      @default(5)
  /// Optional explicit reorder point. If non-null and `available` <= this,
  /// the product is flagged for purchase planning.
  reorderPoint      Int?
  updatedAt         DateTime
}

model InventoryInwardBatch {
  id              String   @id
  referenceNumber String   @unique
  supplierName    String
  remarks         String
  createdAt       DateTime @default(now())
  createdBy       String
  attachmentNames Json
  lines           Json
}

model InventoryMovement {
  id               String   @id
  productId        String
  type             String
  quantity         Int
  reason           String
  relatedQuoteId   String?
  relatedChallanId String?
  createdAt        DateTime @default(now())
  createdBy        String

  @@index([productId])
  @@index([type])
  @@index([relatedQuoteId])
  @@index([relatedChallanId])
  @@index([createdAt(sort: Desc)])
}

model PurchaseDemand {
  id                  String    @id
  sourceType          String    @default("sales_order")
  sourceLineKey       String    @unique
  sourceOrderId       String?
  sourceQuoteId       String?
  sourceReservationId String?
  customerId          String?
  ownerId             String?
  productId           String?
  sku                 String
  name                String
  category            String
  brand               String
  finish              String?
  unit                String    @default("PC")
  quantity            Int
  orderedQuantity     Int       @default(0)
  receivedQuantity    Int       @default(0)
  status              String    @default("open")
  priority            Int       @default(0)
  preferredVendorId   String?
  vendorName          String?
  expectedDate        DateTime?
  notes               String    @default("")
  metadata            Json      @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime

  @@index([sourceOrderId])
  @@index([sourceQuoteId])
  @@index([sourceReservationId])
  @@index([productId])
  @@index([status])
  @@index([expectedDate])
  @@index([createdAt(sort: Desc)])
}

model PurchaseOrder {
  id           String    @id
  poNumber     String    @unique
  vendorId     String?
  vendorName   String
  status       String    @default("draft")
  expectedDate DateTime?
  sentAt       DateTime?
  orderedAt    DateTime?
  closedAt     DateTime?
  createdBy    String
  notes        String    @default("")
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime

  @@index([vendorId])
  @@index([vendorName])
  @@index([status])
  @@index([expectedDate])
  @@index([createdAt(sort: Desc)])
}

model PurchaseOrderLine {
  id                String   @id
  purchaseOrderId   String
  purchaseDemandId  String?
  productId         String?
  sku               String
  name              String
  category          String
  brand             String
  finish            String?
  unit              String   @default("PC")
  orderedQuantity   Int
  receivedQuantity  Int      @default(0)
  cancelledQuantity Int      @default(0)
  unitCost          Float    @default(0)
  status            String   @default("ordered")
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime

  @@index([purchaseOrderId])
  @@index([purchaseDemandId])
  @@index([productId])
  @@index([status])
}

model GoodsReceiptNote {
  id              String   @id
  grnNumber       String   @unique
  purchaseOrderId String?
  vendorId        String?
  vendorName      String
  supplierChallan String?
  supplierBill    String?
  receivedDate    DateTime
  receivedBy      String
  status          String   @default("posted")
  notes           String   @default("")
  attachments     Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@index([purchaseOrderId])
  @@index([vendorName])
  @@index([receivedDate])
  @@index([createdAt(sort: Desc)])
}

model GoodsReceiptLine {
  id                  String   @id
  goodsReceiptNoteId  String
  purchaseOrderLineId String?
  productId           String?
  sku                 String
  name                String
  orderedQuantity     Int
  receivedQuantity    Int
  acceptedQuantity    Int
  damagedQuantity     Int      @default(0)
  location            String?
  unitCost            Float    @default(0)
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now())

  @@index([goodsReceiptNoteId])
  @@index([purchaseOrderLineId])
  @@index([productId])
}

model Lead {
  id            String         @id
  customer      Customer       @relation(fields: [customerId], references: [id])
  customerId    String
  title         String
  source        String
  owner         User           @relation(fields: [ownerId], references: [id])
  ownerId       String
  stage         String
  expectedValue Float
  createdAt     DateTime       @default(now())
  lastContactAt DateTime
  nextActionAt  DateTime
  notes         String
  reopenedAt    DateTime?
  updatedAt     DateTime
  activities    Activity[]
  quotes        Quote[]
  followUps     FollowUpTask[]

  @@index([customerId])
  @@index([ownerId])
  @@index([stage])
  @@index([nextActionAt])
  @@index([createdAt(sort: Desc)])
}

model LeadIntent {
  id                String    @id
  leadId            String
  customerId        String
  ownerId           String
  createdBy         String
  status            String
  intentType        String
  source            String
  notes             String
  followUpReason    String?
  rows              Json
  quoteId           String?
  referencesQuoteId String?
  lockedBy          String?
  lockedAt          DateTime?
  submittedAt       DateTime?
  salesOrderId      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime

  @@index([leadId])
  @@index([ownerId])
  @@index([status])
  @@index([referencesQuoteId])
  @@index([lockedBy])
  @@index([createdAt(sort: Desc)])
}

model Notification {
  id           String    @id
  title        String
  message      String
  type         String
  entityType   String?
  entityId     String?
  href         String?
  targetUserId String?
  targetRole   String?
  metadata     Json      @default("{}")
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([targetUserId])
  @@index([targetRole])
  @@index([readAt])
  @@index([createdAt(sort: Desc)])
}

model PasswordResetToken {
  id        String    @id
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ProductCategory {
  id          String   @id
  name        String   @unique
  code        String?
  description String?
  status      String   @default("active")
  sortOrder   Int      @default(0)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model ProductBrand {
  id          String   @id
  name        String   @unique
  code        String?
  description String?
  status      String   @default("active")
  sortOrder   Int      @default(0)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model ProductFinish {
  id          String   @id
  name        String   @unique
  code        String?
  description String?
  status      String   @default("active")
  sortOrder   Int      @default(0)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model TileSize {
  id          String   @id
  name        String   @unique
  code        String?
  uom         String   @default("BOX")
  pcsPerBox   Int      @default(0)
  description String?
  status      String   @default("active")
  sortOrder   Int      @default(0)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model Product {
  id           String            @id
  sku          String            @unique
  name         String
  category     String
  brand        String
  finish       String
  dimensions   String
  unit         String
  tags         Json
  sellPrice    Float
  floorPrice   Float
  taxClass     String
  status       String
  media        Json
  sourceRefs   Json
  description  String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime
  balances     InventoryBalance?
  reservations Reservation[]

  @@index([brand])
  @@index([category])
  @@index([finish])
  @@index([status])
  @@index([name])
}

model Quote {
  id                  String            @id
  quoteNumber         String            @unique
  lead                Lead              @relation(fields: [leadId], references: [id])
  leadId              String
  customer            Customer          @relation(fields: [customerId], references: [id])
  customerId          String
  owner               User              @relation(fields: [ownerId], references: [id])
  ownerId             String
  title               String
  status              String
  approvalStatus      String
  discountPercent     Float
  displayMode         String            @default("priced")
  projectName         String
  createdAt           DateTime          @default(now())
  validUntil          DateTime
  sentAt              DateTime?
  confirmedAt         DateTime?
  coverImage          String
  notes               String
  lines               Json
  versions            Json
  quoteMeta           Json              @default("{}")
  approval            Json?
  intentId            String?
  supersedesQuoteId   String?
  supersededByQuoteId String?
  versionNumber       Int               @default(1)
  updatedAt           DateTime
  activities          Activity[]
  reservations        Reservation[]
  dispatchJobs        DispatchJob?
  dispatchChallan     DispatchChallan[]

  @@index([leadId])
  @@index([customerId])
  @@index([ownerId])
  @@index([status])
  @@index([approvalStatus])
  @@index([validUntil])
  @@index([intentId])
  @@index([supersedesQuoteId])
  @@index([supersededByQuoteId])
  @@index([createdAt(sort: Desc)])
}

model Reservation {
  id        String   @id
  quote     Quote    @relation(fields: [quoteId], references: [id])
  quoteId   String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([quoteId, status])
  @@index([productId, status])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model Session {
  id         String    @id
  token      String    @unique
  tokenHash  String?   @unique
  userId     String
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model SalesOrder {
  id            String   @id
  orderNumber   String   @unique
  quoteId       String   @unique
  leadId        String
  customerId    String
  ownerId       String
  status        String
  paymentMode   String
  paymentStatus String
  advanceAmount Float
  totalAmount   Float
  lines         Json
  notes         String
  documents     Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime

  @@index([leadId])
  @@index([customerId])
  @@index([ownerId])
  @@index([paymentMode])
  @@index([createdAt(sort: Desc)])
}

model QuoteLine {
  id            String   @id
  quoteId       String
  lineKey       String
  lineNo        Int
  productId     String?
  sku           String
  name          String
  category      String
  brand         String
  finish        String?
  area          String?
  unit          String   @default("PC")
  quantity      Int
  unitPrice     Float    @default(0)
  lineTotal     Float    @default(0)
  status        String   @default("quoted")
  isTileSpecial Boolean  @default(false)
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime

  @@unique([quoteId, lineKey])
  @@index([quoteId])
  @@index([productId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model SalesOrderLine {
  id                  String   @id
  salesOrderId        String
  quoteId             String
  quoteLineId         String?
  lineKey             String
  lineNo              Int
  productId           String?
  sku                 String
  name                String
  category            String
  brand               String
  finish              String?
  area                String?
  unit                String   @default("PC")
  orderedQuantity     Int
  reservedQuantity    Int      @default(0)
  backorderedQuantity Int      @default(0)
  allocatedQuantity   Int      @default(0)
  dispatchedQuantity  Int      @default(0)
  deliveredQuantity   Int      @default(0)
  returnedQuantity    Int      @default(0)
  unitPrice           Float    @default(0)
  lineTotal           Float    @default(0)
  status              String   @default("open")
  isTileSpecial       Boolean  @default(false)
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime

  @@unique([salesOrderId, lineKey])
  @@index([salesOrderId])
  @@index([quoteId])
  @@index([productId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model DocumentJob {
  id           String    @id
  entityType   String
  entityId     String
  documentType String
  status       String    @default("pending")
  url          String?
  storageKey   String?
  contentType  String    @default("application/pdf")
  error        String?
  retryCount   Int       @default(0)
  generatedBy  String?
  generatedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  metadata     Json      @default("{}")

  @@unique([entityType, entityId, documentType])
  @@index([entityType, entityId])
  @@index([documentType])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model PaymentReceipt {
  id            String    @id
  receiptNumber String    @unique
  salesOrderId  String
  customerId    String
  paymentMode   String
  amount        Float
  status        String    @default("posted")
  receivedAt    DateTime
  dueDate       DateTime?
  reference     String?
  notes         String    @default("")
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  metadata      Json      @default("{}")

  @@index([salesOrderId])
  @@index([customerId])
  @@index([paymentMode])
  @@index([status])
  @@index([receivedAt(sort: Desc)])
}

model SequenceCounter {
  scope     String   @id
  value     Int      @default(0)
  updatedAt DateTime
}

model StockLocation {
  id        String   @id
  code      String   @unique
  name      String
  type      String   @default("showroom")
  status    String   @default("active")
  address   String?
  sortOrder Int      @default(0)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([status])
  @@index([type])
}

model StockBalanceByLocation {
  id         String   @id
  productId  String
  locationId String
  onHand     Int      @default(0)
  reserved   Int      @default(0)
  damaged    Int      @default(0)
  hold       Int      @default(0)
  updatedAt  DateTime

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
}

model StockLedgerEntry {
  id               String   @id
  productId        String?
  locationId       String?
  type             String
  quantity         Int
  direction        String
  referenceType    String?
  referenceId      String?
  sourceDocumentNo String?
  unitCost         Float    @default(0)
  reason           String
  createdBy        String
  createdAt        DateTime @default(now())
  metadata         Json     @default("{}")

  @@index([productId])
  @@index([locationId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdAt(sort: Desc)])
}

model StockCountSession {
  id          String    @id
  countNumber String    @unique
  status      String    @default("draft")
  scope       String    @default("all")
  locationId  String?
  notes       String    @default("")
  createdBy   String
  approvedBy  String?
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  metadata    Json      @default("{}")

  @@index([status])
  @@index([locationId])
  @@index([startedAt(sort: Desc)])
}

model StockCountLine {
  id               String   @id
  stockCountId     String
  productId        String
  expectedQuantity Int
  countedQuantity  Int
  variance         Int
  reason           String   @default("")
  status           String   @default("counted")
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  metadata         Json     @default("{}")

  @@unique([stockCountId, productId])
  @@index([stockCountId])
  @@index([productId])
  @@index([status])
}

model StockAdjustmentApproval {
  id          String    @id
  productId   String
  quantity    Int
  type        String
  status      String    @default("pending")
  reason      String
  requestedBy String
  approvedBy  String?
  referenceId String?
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?
  metadata    Json      @default("{}")

  @@index([productId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model ProductVendor {
  id           String   @id
  productId    String
  vendorId     String
  vendorSku    String?
  vendorName   String
  leadTimeDays Int      @default(0)
  minOrderQty  Int      @default(1)
  packMultiple Int      @default(1)
  lastCost     Float    @default(0)
  preferred    Boolean  @default(false)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  metadata     Json     @default("{}")

  @@unique([productId, vendorId])
  @@index([productId])
  @@index([vendorId])
  @@index([preferred])
  @@index([status])
}

model ReorderPolicy {
  id                String   @id
  productId         String   @unique
  preferredVendorId String?
  minQuantity       Int      @default(0)
  maxQuantity       Int      @default(0)
  reorderPoint      Int      @default(0)
  reorderQuantity   Int      @default(0)
  leadTimeDays      Int      @default(0)
  packMultiple      Int      @default(1)
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  metadata          Json     @default("{}")

  @@index([preferredVendorId])
  @@index([status])
}

model DispatchPackage {
  id            String    @id
  dispatchJobId String
  challanId     String
  packageNumber String
  boxCount      Int       @default(1)
  status        String    @default("packed")
  packedBy      String?
  packedAt      DateTime?
  remarks       String    @default("")
  photos        Json      @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  metadata      Json      @default("{}")

  @@unique([challanId, packageNumber])
  @@index([dispatchJobId])
  @@index([challanId])
  @@index([status])
}

model DispatchLine {
  id                 String   @id
  dispatchJobId      String
  challanId          String?
  salesOrderId       String?
  salesOrderLineId   String?
  dispatchKey        String
  productId          String?
  sku                String
  name               String
  orderedQuantity    Int
  packedQuantity     Int      @default(0)
  dispatchedQuantity Int      @default(0)
  deliveredQuantity  Int      @default(0)
  returnedQuantity   Int      @default(0)
  status             String   @default("packed")
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  metadata           Json     @default("{}")

  @@index([dispatchJobId])
  @@index([challanId])
  @@index([salesOrderId])
  @@index([salesOrderLineId])
  @@index([productId])
  @@index([status])
}

model Shipment {
  id              String    @id
  shipmentNumber  String    @unique
  dispatchJobId   String
  challanId       String
  transporterName String?
  vehicleNumber   String?
  driverName      String?
  contactPhone    String?
  status          String    @default("ready")
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  metadata        Json      @default("{}")

  @@index([dispatchJobId])
  @@index([challanId])
  @@index([status])
}

model DeliveryProof {
  id              String   @id
  shipmentId      String?
  challanId       String
  receivedByName  String
  receivedByPhone String?
  proofType       String   @default("manual")
  proofUrl        String?
  latitude        Float?
  longitude       Float?
  capturedAt      DateTime @default(now())
  createdBy       String
  metadata        Json     @default("{}")

  @@index([shipmentId])
  @@index([challanId])
  @@index([capturedAt(sort: Desc)])
}

model ReturnOrder {
  id           String    @id
  returnNumber String    @unique
  salesOrderId String?
  challanId    String?
  customerId   String?
  status       String    @default("draft")
  reason       String
  refundMode   String?
  refundAmount Float     @default(0)
  createdBy    String
  approvedBy   String?
  receivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  metadata     Json      @default("{}")

  @@index([salesOrderId])
  @@index([challanId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model ReturnLine {
  id            String   @id
  returnOrderId String
  productId     String?
  sku           String
  name          String
  quantity      Int
  disposition   String   @default("inspect")
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  metadata      Json     @default("{}")

  @@index([returnOrderId])
  @@index([productId])
  @@index([status])
}

model SourceFile {
  id         String   @id
  kind       String
  name       String
  path       String   @unique
  uploadedBy String
  status     String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}

model User {
  id                String         @id
  name              String
  email             String         @unique
  passwordHash      String
  role              String
  phone             String
  active            Boolean        @default(true)
  /// Optional uploaded avatar URL. When null the UI falls back to a
  /// deterministic colour + initials block derived from `id`.
  avatarUrl         String?
  /// One-line bio shown on the profile page. Not validated; kept short
  /// (<= 280 chars) in the resolver.
  bio               String?
  /// Per-user RBAC changes layered on top of the base role. Keys map to
  /// explicit permissions such as users.manage or products.manage.
  permissionOverrides Json           @default("{}")
  /// Audit trail for password rotations. Used by the profile page to show
  /// "last changed N days ago" + by future password-expiry policies.
  passwordChangedAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  leads             Lead[]
  quotes            Quote[]
  activities        Activity[]
  followUps         FollowUpTask[]
  dispatchJobs      DispatchJob[]
}

model Vendor {
  id            String   @id
  name          String
  phone         String?
  email         String?
  gstNo         String?
  address       String?
  city          String?
  state         String?
  contactPerson String?
  category      String?
  status        String   @default("active")
  notes         String?
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime

  @@index([name])
  @@index([status])
}

model Payment {
  id           String   @id
  salesOrderId String
  customerId   String?
  amount       Float
  mode         String
  reference    String?
  paidAt       DateTime @default(now())
  notes        String?
  recordedBy   String
  direction    String   @default("incoming")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([salesOrderId])
  @@index([customerId])
  @@index([mode])
  @@index([paidAt(sort: Desc)])
}

model Communication {
  id          String   @id
  customerId  String?
  leadId      String?
  type        String
  direction   String   @default("outbound")
  summary     String
  body        String?
  occurredAt  DateTime @default(now())
  recordedBy  String
  attachments Json     @default("[]")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([customerId, occurredAt(sort: Desc)])
  @@index([leadId, occurredAt(sort: Desc)])
  @@index([type])
}

model ReturnRecord {
  id              String   @id
  returnNumber    String   @unique
  salesOrderId    String?
  challanId       String?
  customerId      String
  status          String   @default("pending")
  reason          String
  reasonCategory  String?
  refundAmount    Float    @default(0)
  refundPaymentId String?
  lines           Json     @default("[]")
  notes           String?
  recordedBy      String
  receivedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@index([salesOrderId])
  @@index([challanId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model SalesTarget {
  id        String   @id
  userId    String
  month     String
  amount    Float
  notes     String?
  setBy     String
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@unique([userId, month])
  @@index([month])
}

model PortalToken {
  id         String    @id
  token      String    @unique
  customerId String
  scope      String    @default("read")
  expiresAt  DateTime
  revokedAt  DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())

  @@index([customerId])
  @@index([expiresAt])
}
