# Database
DATABASE_URL="postgresql://devarshthakkar@localhost/marble_park?host=/tmp&schema=public"

# API
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=marble-park-jwt-secret-change-in-production

# Product Master/catalogue images uploaded manually or imported from Excel.
# Leave blank locally to write into the Next public catalogue folder.
CATALOGUE_IMAGE_STORAGE_DIR=
PUBLIC_CATALOGUE_IMAGE_BASE_URL=
# On EC2 mount this on persistent EBS storage, for example /srv/marble-park/assets.
# Delivery proofs and Product Master images are served from this durable directory.

# SMTP (for email)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@marblepark.in
# SMTP_USER=
# SMTP_PASS=

# CORS
CORS_ORIGIN=http://localhost:3000
