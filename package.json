{
  "name": "marble-park",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "start": "node scripts/railway-start.mjs",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:push": "npm run db:push --workspace=apps/api",
    "db:migrate:dev": "npm run db:migrate:dev --workspace=apps/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "smoke:intent-order": "node scripts/e2e-lead-intent-order-smoke.mjs",
    "smoke:multi-round": "node scripts/e2e-multi-round-selection-smoke.mjs",
    "system:upgrade": "node scripts/upgrade-retail-os.mjs",
    "smoke:quote-notifications": "node scripts/e2e-quote-area-notification-smoke.mjs",
    "smoke:production-hardening": "node scripts/e2e-production-hardening-smoke.mjs",
    "smoke:rbac-users": "node scripts/e2e-rbac-user-management-smoke.mjs",
    "smoke:readiness": "node scripts/e2e-readiness-import-smoke.mjs",
    "smoke:product-create": "node scripts/e2e-product-create-optional-fields-smoke.mjs",
    "smoke:quote-procurement": "node scripts/e2e-quote-assets-procurement-defaults-smoke.mjs",
    "smoke:excel-runtime": "node scripts/verify-excel-runtime.mjs",
    "smoke:document-vault": "node scripts/e2e-document-vault-smoke.mjs",
    "smoke:client-workflow": "node scripts/e2e-client-workflow-release-gate.mjs",
    "smoke:customer-accounts": "node scripts/e2e-customer-accounts-e2e.mjs",
    "smoke:release-contract": "node scripts/e2e-release-contract-smoke.mjs",
    "smoke:tile-area": "node scripts/e2e-tile-area-pricing-smoke.mjs",
    "smoke:branded": "node scripts/e2e-branded-quotation-smoke.mjs",
    "smoke:import-scale": "node scripts/e2e-product-import-scale-smoke.mjs",
    "cleanup:e2e": "node scripts/cleanup-client-flow-test-data.mjs",
    "reset:client-data": "node scripts/reset-client-test-data.mjs"
  },
  "dependencies": {
    "minimatch": "file:vendor/minimatch-compat"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "sharp": "0.35.3",
    "tmp": "0.2.7",
    "shell-quote": "1.8.4",
    "next": {
      "postcss": "8.5.19"
    },
    "exceljs": {
      "uuid": "11.1.1",
      "unzipper": "0.12.5"
    },
    "minimatch": "$minimatch",
    "ws": "8.21.0",
    "subscriptions-transport-ws": {
      "ws": "7.5.11"
    },
    "tsx": {
      "esbuild": "0.28.1"
    }
  }
}
