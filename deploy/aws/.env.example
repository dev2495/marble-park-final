# The Elastic IP with dots replaced by hyphens, for example 13-232-10-20.sslip.io.
APP_HOST=
DATA_ROOT=/srv/marble-park

# File vault defaults: 1 GB per file and 50 GB total, persisted inside DATA_ROOT/assets.
DOCUMENT_VAULT_MAX_FILE_BYTES=1073741824
DOCUMENT_VAULT_MAX_TOTAL_BYTES=53687091200

POSTGRES_DB=marble_park
POSTGRES_USER=marble_park
POSTGRES_PASSWORD=
JWT_SECRET=

BOOTSTRAP_OWNER_NAME=Devarsh
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_PHONE=

# Contracted authenticated idle timeout. Production preflight rejects any
# value other than exactly 15 minutes.
SESSION_IDLE_TIMEOUT_MINUTES=15

# Optional off-host backup target. The EC2 instance profile must allow s3:PutObject.
BACKUP_S3_URI=
